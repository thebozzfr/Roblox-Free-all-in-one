-- Helper Builders for System Toggles and Modifiers
local function createInteractiveToggle(parent, title, keyRef)
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(1, -10, 0, 30)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    toggleBtn.Text = title .. ": CLOSED"
    toggleBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    toggleBtn.Font = Enum.Font.SourceSansBold
    toggleBtn.TextSize = 13
    toggleBtn.Parent = parent
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 4)
    
    toggleBtn.MouseButton1Click:Connect(function()
        UI_State.Settings[keyRef] = not UI_State.Settings[keyRef]
        local active = UI_State.Settings[keyRef]
        
        toggleBtn.BackgroundColor3 = active and Color3.fromRGB(0, 60, 90) or Color3.fromRGB(28, 28, 36)
        toggleBtn.TextColor3 = active and Color3.fromRGB(0, 200, 255) or Color3.fromRGB(150, 150, 150)
        toggleBtn.Text = title .. (active and ": ACTIVE" or ": CLOSED")
    end)
end

local function createNumericInputBox(parent, clearLabel, targetKey)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -10, 0, 30)
    container.BackgroundTransparency = 1
    container.Parent = parent
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(0.5, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = clearLabel
    textLabel.TextColor3 = Color3.fromRGB(140, 140, 150)
    textLabel.Font = Enum.Font.SourceSans
    textLabel.TextSize = 13
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.Parent = container
    
    local inputBox = Instance.new("TextBox")
    inputBox.Size = UDim2.new(0.5, 0, 1, 0)
    inputBox.Position = UDim2.new(0.5, 0, 0, 0)
    inputBox.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
    inputBox.Text = tostring(UI_State.Settings[targetKey])
    inputBox.TextColor3 = Color3.fromRGB(0, 170, 255)
    inputBox.Font = Enum.Font.SourceSansBold
    inputBox.TextSize = 13
    inputBox.Parent = container
    Instance.new("UICorner", inputBox).CornerRadius = UDim.new(0, 4)
    
    inputBox.FocusLost:Connect(function()
        local convertedNum = tonumber(inputBox.Text)
        if convertedNum then
            UI_State.Settings[targetKey] = convertedNum
        else
            inputBox.Text = tostring(UI_State.Settings[targetKey])
        end
